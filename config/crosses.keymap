#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// JIS host layout mappings. These emit the HID usages that produce the
// intended characters while the OS keyboard layout is set to Japanese.
#define JP_DQUOTE AT
#define JP_AMPERSAND CARET
#define JP_QUOTE AMPERSAND
#define JP_EQUAL UNDER
#define JP_CARET EQUAL
#define JP_YEN INTERNATIONAL_3
#define JP_PLUS COLON
#define JP_TILDE PLUS
#define JP_PIPE LS(INTERNATIONAL_3)
#define JP_AT LEFT_BRACKET
#define JP_COLON SINGLE_QUOTE
#define JP_ASTERISK DOUBLE_QUOTES
#define JP_BACKQUOTE LEFT_BRACE
#define JP_UNDERSCORE LS(INTERNATIONAL_1)
#define JP_LBRACKET RIGHT_BRACKET
#define JP_RBRACKET BACKSLASH
#define JP_LPAREN ASTERISK
#define JP_RPAREN LEFT_PARENTHESIS
#define JP_LBRACE RIGHT_BRACE
#define JP_RBRACE PIPE
#define JP_KANA LANGUAGE_1
#define JP_EISU LANGUAGE_2
#define JP_HANZEN GRAVE

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    macros {
        ime_on: ime_on {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp JP_KANA &kp F23>;
        };

        ime_off: ime_off {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp JP_EISU &kp F24>;
        };
    };

    behaviors {
        ime_off_mt: ime_off_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&ime_off>;
        };

        ime_on_lt: ime_on_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            bindings = <&mo>, <&ime_on>;
        };
    };

    combos {
        compatible = "zmk,combos";

        mclk {
            bindings = <&mkp MCLK>;
            key-positions = <16 15>;
        };

        whispering {
            bindings = <&kp LA(LS(D))>;
            key-positions = <34 35>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&lt 3 Q  &kp W  &kp E                 &kp R               &kp T                 &kp Y          &kp U      &kp I             &kp O       &kp P
&kp A    &kp S  &kp D                 &kp F               &kp G                 &kp H          &kp J      &kp K             &lt 4 L     &kp MINUS
&lt 1 Z  &kp X  &kp C                 &kp V               &kp B                 &kp N          &kp M      &kp COMMA         &kp PERIOD  &kp LEFT_WIN
                &ime_off_mt LCTRL 0   &mt LEFT_SHIFT TAB  &mt LEFT_ALT SPACE    &kp BACKSPACE  &kp ENTER  &ime_on_lt 2 0
            >;
        };

        layer_1 {
            bindings = <
&kp JP_QUOTE      &kp JP_DQUOTE  &kp HASH        &kp DOLLAR    &kp JP_YEN      &kp N7        &kp N8        &kp N9        &kp JP_PLUS      &kp MINUS
&kp JP_AMPERSAND  &kp JP_AT      &kp EXCL        &kp UP_ARROW  &kp QUESTION    &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp JP_ASTERISK  &kp SLASH
&none             &kp JP_COLON   &kp LEFT_ARROW  &kp DOWN      &kp RIGHT       &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp N0           &kp ENTER
                                     &none           &none         &kp SPACE        &kp DELETE    &kp ENTER     &kp SPACE
            >;
        };

        layer_2 {
            bindings = <
&kp F1  &kp F2          &kp F3          &kp F4           &kp F5           &kp F6  &kp F7                &kp F8                 &kp F9          &kp F10
&none   &none           &kp UP_ARROW    &none            &kp PAGE_UP      &none   &kp JP_LPAREN  &kp JP_RPAREN  &kp F11            &kp F12
&none   &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp PAGE_DOWN    &trans  &kp JP_EQUAL   &kp JP_TILDE   &kp JP_UNDERSCORE  &kp JP_PIPE
                        &none           &none            &none            &none   &none                 &kp SPACE
            >;
        };

        layer_3 {
            bindings = <
&none  &none  &none  &none  &none    &none       &none         &none         &none         &none
&none  &none  &none  &none  &none    &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3
&none  &none  &none  &none  &none    &none       &none         &none         &none         &studio_unlock
              &none  &none  &none    &none       &none         &kp SPACE
            >;
        };

        layer_4 {
            bindings = <
&trans     &trans     &trans        &trans  &trans    &trans  &trans    &trans    &trans  &trans
&trans     &trans     &trans        &trans  &trans    &trans  &mkp MB4  &mkp MB5  &trans  &trans
&kp LCTRL  &kp LSHFT  &kp LEFT_ALT  &trans  &trans    &trans  &trans    &trans    &trans  &trans
                      &trans        &trans  &trans    &trans  &trans    &trans
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans  &trans     &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &mkp LCLK  &mkp RCLK  &mo 4   &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans     &trans     &trans  &trans
                &trans  &trans  &trans    &trans  &trans     &trans
            >;
        };

        /* layer_2 {
            bindings = <
&none  &none   &none    &none   &none         &none         &kp N1         &none         &none     &none  &none   &to 0
&none  &none   &none    &none   &none         &none         &none         &none          &rgb_ug RGB_BRD &rgb_ug RGB_BRI  &rgb_ug RGB_EFF   &rgb_ug RGB_TOG
&none  &none   &none    &none   &none         &none         &none         &mkp LCLK     &mkp RCLK  &none  &none   &none
&none  &none   &none    &none   &bt BT_NXT  &bt BT_CLR    &none         &none         &none     &none  &none   &none
                                   &none         &none         &none         &none         &none
                                                 &none         &none         &none
            >;
       
            
        };

       Mouse {
            bindings = <
&none        &none         &none         &none         &none      &none         &none       &none      &none         &none         &none         &none
&none        &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 3  &none      &bt BT_CLR    &bt BT_CLR  &none      &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &none
&none        &trans        &trans        &mkp MCLK     &trans     &none         &none       &trans     &mkp MCLK     &trans        &trans        &none
&bootloader  &trans        &mkp RCLK     &mo 4         &mkp LCLK  &mo 5         &mo 5       &mkp LCLK  &mo 4         &mkp RCLK     &trans        &bootloader
                                         &mo 5         &mkp LCLK  &mkp RCLK     &mkp RCLK   &mkp LCLK
                                                       &none      &trans        &trans
            >;

            
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &mkp MCLK  &trans     &trans       &trans     &trans     &mkp MCLK  &trans     &trans  &trans
&trans  &trans  &mkp RCLK  &trans     &mkp LCLK  &trans       &trans     &mkp LCLK  &trans     &mkp RCLK  &trans  &trans
                           &trans     &mkp LCLK  &mkp RCLK    &mkp RCLK  &mkp LCLK
                                      &trans     &trans       &trans
            >;
                
                
               
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &mkp MCLK  &trans     &trans       &trans     &trans     &mkp MCLK  &trans     &trans  &trans
&trans  &trans  &mkp RCLK  &trans     &mkp LCLK  &trans       &trans     &mkp LCLK  &trans     &mkp RCLK  &trans  &trans
                           &trans     &mkp LCLK  &mkp RCLK    &mkp RCLK  &mkp LCLK
                                      &trans     &trans       &trans
            >;
                
                
        };*/
    };
};

//&mkp_input_listener { input-processors = <&zip_temp_layer 5 250>; };
